@model IEnumerable<DhlLab5.Models.DhlMajor>

<nav id="major-filter" aria-label="Lọc theo ngành">
    <ul class="nav nav-pills flex-wrap gap-2">
        <li class="nav-item">
            <a class="nav-link @(ViewBag.SelectedMajorId is null ? "active" : string.Empty)"
               asp-controller="DhlLearner" asp-action="Index" data-major-id="">Tất cả ngành</a>
        </li>
        @foreach (var major in Model)
        {
            <li class="nav-item">
                <a class="nav-link @(ViewBag.SelectedMajorId == major.MajorID ? "active" : string.Empty)"
                   asp-controller="DhlLearner" asp-action="Index" asp-route-mid="@major.MajorID"
                   data-major-id="@major.MajorID">@major.MajorName</a>
            </li>
        }
    </ul>
</nav>