<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DhlLab6</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DhlLab6.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="dhl-topbar navbar navbar-dark">
        <div class="container-fluid gap-3">
            <a class="navbar-brand" asp-controller="DhlLearner" asp-action="Index">Management System</a>
            <button class="btn btn-link dhl-menu-toggle" type="button" aria-label="Bật/tắt thanh điều hướng" data-dhl-sidebar-toggle>
                <span aria-hidden="true">☰</span>
            </button>
            <form class="dhl-top-search ms-auto" asp-controller="DhlLearner" asp-action="Index" method="get" role="search">
                <input class="form-control" type="search" name="keyword" value="@(Context.Request.Query["keyword"].ToString())" placeholder="Tìm người học..." aria-label="Tìm người học" />
                <button class="btn btn-primary" type="submit" aria-label="Tìm kiếm">⌕</button>
            </form>
            <span class="dhl-user-icon" title="Tài khoản" aria-hidden="true">♟</span>
        </div>
    </header>

    <div class="dhl-shell">
        <aside class="dhl-sidebar" id="dhlSidebar" aria-label="Điều hướng chính">
            <nav class="dhl-sidebar-nav" aria-label="Main navigation">
                <div class="dhl-sidebar-section">Core</div>
                <a class="dhl-sidebar-link" asp-controller="DhlLearner" asp-action="Index">
                    <span class="dhl-menu-icon" aria-hidden="true">◉</span><span>Dashboard</span>
                </a>
                <div class="dhl-sidebar-section">Addons</div>
                <a class="dhl-sidebar-link" href="#"><span class="dhl-menu-icon" aria-hidden="true">▰</span><span>Branches</span></a>
                <a class="dhl-sidebar-link" href="/Admin/Student/List"><span class="dhl-menu-icon" aria-hidden="true">▰</span><span>Students</span></a>
                <a class="dhl-sidebar-link" href="#"><span class="dhl-menu-icon" aria-hidden="true">▰</span><span>Subjects</span></a>
                <a class="dhl-sidebar-link" href="#"><span class="dhl-menu-icon" aria-hidden="true">▰</span><span>Courses</span></a>
            </nav>
            <div class="dhl-sidebar-bottom"><span aria-hidden="true">●</span><span>Signed in</span></div>
        </aside>

        <div class="dhl-main-column">
            <main class="dhl-content" role="main">
                @RenderBody()
            </main>
            <footer class="dhl-footer">
                <span>&copy; @DateTime.Now.Year DhlLab6</span>
                <a asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>