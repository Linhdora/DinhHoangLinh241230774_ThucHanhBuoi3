@model DhlLab6.Models.StudentListViewModel
@{
    string BranchName(DhlLab6.Models.Branch? branch) => branch switch
    {
        DhlLab6.Models.Branch.IT => "CNTT",
        DhlLab6.Models.Branch.BE => "Kinh tế",
        DhlLab6.Models.Branch.CE => "Công trình",
        DhlLab6.Models.Branch.EE => "Điện - Điện tử",
        _ => "Chưa phân ngành"
    };
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Ảnh</th>
                <th>Mã</th>
                <th>Họ tên</th>
                <th>Ngày sinh</th>
                <th>Ngành</th>
                <th>Giới tính</th>
                <th>Hệ đào tạo</th>
                <th>Địa chỉ</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.Students)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(student.AvatarUrl))
                        {
                            <img src="~/images/@student.AvatarUrl" alt="Ảnh của @student.Name" width="40" height="40" class="rounded-circle object-fit-cover" />
                        }
                        else
                        {
                            <span class="text-secondary">Chưa có ảnh</span>
                        }
                    </td>
                    <td>@student.Id</td>
                    <td>@student.Name</td>
                    <td>@student.DateOfBorth.ToString("d")</td>
                    <td>@BranchName(student.Branch)</td>
                    <td>@(student.Gender == DhlLab6.Models.Gender.Male ? "Nam" : "Nữ")</td>
                    <td>@(student.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                    <td>@student.Address</td>
                    <td>@student.Email</td>
                </tr>
            }
            @if (Model.Students.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-secondary">Không tìm thấy sinh viên phù hợp.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span class="text-secondary">@Model.TotalCount kết quả · Trang @Model.PageNum / @Model.PageCount</span>
    @if (Model.PageCount > 1)
    {
        <nav aria-label="Phân trang danh sách sinh viên">
            <ul class="pagination mb-0">
                @for (var pageNumber = 1; pageNumber <= Model.PageCount; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.PageNum ? "active" : string.Empty)">
                        <a class="page-link" data-page="@pageNumber"
                           href="@Url.Action("Index", "DhlStudent", new { mid = Model.Mid, keyword = Model.Keyword, pageIndex = pageNumber })"
                           aria-current="@(pageNumber == Model.PageNum ? "page" : null)">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>